# Copia este archivo como .env y rellena los valores reales
# cp .env.example .env

# Clave de la API de Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# De developers.facebook.com > tu app > WhatsApp > API Setup. Un solo token
# sirve para TODOS los negocios dados de alta, siempre que sus números de
# WhatsApp estén agregados bajo esta misma cuenta/app de Meta.
WHATSAPP_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX

# Cualquier string secreta que tú inventes (la vas a pegar también en el
# formulario de configuración del webhook en Meta, debe ser idéntica ahí).
# Un solo webhook recibe los mensajes de TODOS los negocios dados de alta.
WHATSAPP_VERIFY_TOKEN=escoge-una-frase-secreta

# Bot de Telegram dedicado a alertas (creado con @BotFather) — canal
# independiente de WhatsApp, para que te avise aunque WhatsApp esté caído.
# Cada alerta llega etiquetada con el nombre del negocio al que pertenece.
TELEGRAM_ALERT_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_ALERT_CHAT_ID=000000000

# Cuenta de servicio de Google (JSON completo en una sola linea, entre comillas
# simples) y el ID de la hoja de calculo donde vive todo: el reporte diario y
# las citas de cada negocio (una pestaña por negocio), y la pestaña de
# control "Clientes" que dice qué número de WhatsApp pertenece a cuál negocio.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
GOOGLE_SHEET_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Upstash Redis (upstash.com, plan Free) — guarda la memoria de cada
# conversación para que sobreviva reinicios del servidor (no vive en RAM),
# y cachea por 5 minutos la config de cada negocio para no leer Sheets en
# cada mensaje.
UPSTASH_REDIS_REST_URL=https://tu-base.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────
# IMPORTANTE: ya NO hay que configurar aquí el nombre del negocio, su
# número de WhatsApp ni el teléfono del dueño — eso ahora vive en la
# pestaña "Clientes" de la hoja de cálculo de arriba (una fila por negocio:
# Phone Number ID | Nombre del negocio | Teléfono del dueño | Teléfonos
# adicionales | Activo | Información del negocio). Dar de alta un negocio
# nuevo es agregar una fila ahí, no tocar este archivo ni redesplegar nada.
#
# La columna "Información del negocio" es texto libre — pega ahí sus
# horarios, precios y servicios tal cual te los mande el cliente. El bot
# la usa directo para contestar preguntas, sin eso solo puede agendar
# citas pero no sabe responder "¿cuánto cuesta X?" o "¿a qué hora abren?".
