# Copia este archivo como .env y rellena los valores reales
# cp .env.example .env

# Clave de la API de Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# De developers.facebook.com > tu app > WhatsApp > API Setup
WHATSAPP_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Cualquier string secreta que tú inventes (la vas a pegar también en el
# formulario de configuración del webhook en Meta, debe ser idéntica ahí)
WHATSAPP_VERIFY_TOKEN=escoge-una-frase-secreta

# Nombre del negocio que la demo simula atender (para el pitch a prospectos)
BUSINESS_NAME=Mi Negocio Demo

# Tu número de WhatsApp (formato: codigo_pais + numero, sin '+' ni espacios,
# ej. 526461234567) — aqui te llegan las alertas de fallos del bot
ALERT_PHONE_DANIEL=526461234567
